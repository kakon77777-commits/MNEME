{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mneme/schemas/claude-global-projection-request-0.1.schema.json",
  "title": "MNEME ClaudeGlobalProjectionRequest 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_version", "request_id", "expected_source_head", "route_id", "allowed_scope_paths", "required_record_ids", "byte_budget", "target_kind", "projection_ref", "not_claimed", "request_digest"],
  "properties": {
    "request_version": {"const": "mneme.claude-global-projection-request/0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "expected_source_head": {"type": "string", "pattern": "^(GENESIS|[0-9a-f]{64})$"},
    "route_id": {"const": "route://global/tier0"},
    "allowed_scope_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["global/core", "global/collaboration", "global/verification", "global/machine"]}
    },
    "required_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "byte_budget": {"type": "integer", "minimum": 1, "maximum": 16000},
    "target_kind": {"const": "claude_code_user_memory_import"},
    "projection_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"const": ["resident_identity", "private_memory_access", "provider_continuity", "autonomous_write_authority", "cognitive_reconstruction", "claude_memory_readback"]},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
