{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mneme/schemas/claude-publication-receipt-0.1.schema.json",
  "title": "MNEME ClaudePublicationReceipt 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["publication_receipt_version", "receipt_id", "publication_plan_ref", "publication_plan_digest", "authorization_ref", "authorization_digest", "projection_ref", "projection_digest", "target_ref", "target_before_sha256", "target_after_sha256", "readback_sha256", "content_bytes", "outcome", "not_claimed", "receipt_digest"],
  "properties": {
    "publication_receipt_version": {"const": "mneme.claude-publication-receipt/0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "publication_plan_ref": {"type": "string", "minLength": 1},
    "publication_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "authorization_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_ref": {"type": "string", "minLength": 1},
    "projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_ref": {"type": "string", "minLength": 1},
    "target_before_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "target_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_bytes": {"type": "integer", "minimum": 0, "maximum": 16000},
    "outcome": {"enum": ["published", "idempotent"]},
    "not_claimed": {"const": ["resident_identity", "private_memory_access", "provider_continuity", "autonomous_write_authority", "cognitive_reconstruction", "claude_memory_readback"]},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
