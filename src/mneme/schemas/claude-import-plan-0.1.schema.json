{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mneme/schemas/claude-import-plan-0.1.schema.json",
  "title": "MNEME ClaudeImportPlan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["import_plan_version", "plan_id", "projection_ref", "projection_digest", "projection_path_ref", "projection_content_sha256", "projection_content_bytes", "user_memory_ref", "user_memory_preimage_sha256", "managed_block_version", "not_claimed", "plan_digest"],
  "properties": {
    "import_plan_version": {"const": "mneme.claude-import-plan/0.1"},
    "plan_id": {"type": "string", "minLength": 1},
    "projection_ref": {"type": "string", "minLength": 1},
    "projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_path_ref": {"type": "string", "minLength": 1},
    "projection_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_content_bytes": {"type": "integer", "minimum": 0, "maximum": 16000},
    "user_memory_ref": {"type": "string", "minLength": 1},
    "user_memory_preimage_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "managed_block_version": {"const": "MNEME_GLOBAL_PROJECTION/0.1"},
    "not_claimed": {"const": ["resident_identity", "private_memory_access", "provider_continuity", "autonomous_write_authority", "cognitive_reconstruction", "claude_memory_readback"]},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
