{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mneme/schemas/claude-import-receipt-0.1.schema.json",
  "title": "MNEME ClaudeImportReceipt 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["import_receipt_version", "receipt_id", "import_plan_ref", "import_plan_digest", "authorization_ref", "authorization_digest", "transaction_ref", "transaction_digest", "committed_head", "commit_receipt_digest", "publication_receipt_ref", "publication_receipt_digest", "projection_ref", "projection_digest", "user_memory_ref", "user_memory_before_sha256", "user_memory_after_sha256", "readback_sha256", "managed_block_sha256", "outside_bytes_preserved", "outcome", "claude_memory_readback", "not_claimed", "receipt_digest"],
  "properties": {
    "import_receipt_version": {"const": "mneme.claude-import-receipt/0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "import_plan_ref": {"type": "string", "minLength": 1},
    "import_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "authorization_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transaction_ref": {"type": "string", "minLength": 1},
    "transaction_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "committed_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication_receipt_ref": {"type": "string", "minLength": 1},
    "publication_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_ref": {"type": "string", "minLength": 1},
    "projection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "user_memory_ref": {"type": "string", "minLength": 1},
    "user_memory_before_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "user_memory_after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "managed_block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outside_bytes_preserved": {"const": true},
    "outcome": {"enum": ["inserted", "replaced", "idempotent"]},
    "claude_memory_readback": {"enum": ["NOT_RUN", "readback_unmeasured"]},
    "not_claimed": {"const": ["resident_identity", "private_memory_access", "provider_continuity", "autonomous_write_authority", "cognitive_reconstruction", "claude_memory_readback"]},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
