{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mneme/schemas/factorization-proposal-0.1.schema.json",
  "title": "MNEME CPS FactorizationProposal 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_version", "proposal_id", "source_assessments", "source_refs", "anchors",
    "structure", "generators", "obligations", "provenance_refs", "recompute_refs",
    "unresolved_refs", "authority"
  ],
  "properties": {
    "proposal_version": {"const": "mneme.factorization-proposal/0.1"},
    "proposal_id": {"type": "string", "minLength": 1},
    "source_assessments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "anchors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "structure": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "generators": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "obligations": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "provenance_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recompute_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority": {"const": false}
  }
}
