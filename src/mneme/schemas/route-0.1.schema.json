{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/mneme/schemas/route-0.1.schema.json",
  "title": "MNEME Route 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_version", "route_id", "scope_prefixes", "record_types"],
  "properties": {
    "route_version": {"const": "mneme.route/0.1"},
    "route_id": {"type": "string", "pattern": "^route://.+$"},
    "scope_prefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(global|identity|project|task|method)(/[^/]+)?$"}
    },
    "record_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["identity", "instruction", "fact", "lesson", "episode", "project", "relation", "current"]}
    }
  }
}
